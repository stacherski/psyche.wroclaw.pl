---
pagination:
  data: publishedServices
  size: 1
  alias: service
permalink: "/oferta/{{ service.fullName | slugify }}/index.html"
layout: layouts/oferta.njk
eleventyComputed:
  title: "{{ service.fullName }}"
  pageTitle: "{{ service.title }}"
  description: "{{ service.metaDescription }}"
postfix: Centrum PSYCHE Wrocław
isHomepage: false

---

<h1>{{ pageTitle }}</h1>

{% if service.desc01 %}
  <article class="panel">
    <div class="content">
      {{ service.desc01 | safe }}
    </div>
    {% if service.poster01 %}
      <img
        eleventy:optional="placeholder"
        eleventy:widths="300, 600"
        src="/media/{{service.poster01}}"
        alt="{{ service.fullName }} – Centrum PSYCHE Wrocław"
        class="panel-image"
      >
    {% endif %}
  </article>
{% endif %}

{# same booking button as the homepage hero and specialist pages (.btn__booksy) #}
<div class="btn btn__booksy booksy-cta">
  <a
    href="https://booksy.com/pl-pl/36093_psycholog-centrum-psyche-gabinety-psychologiczne_zdrowie_13750_wroclaw"
    target="_blank"
    rel="noopener"
    aria-label="Zarejestruj w Booksy: {{ service.fullName }}"
  >Zarejestruj w Booksy</a>
</div>

<article class="_panel" style="display: grid; gap: var(--space-normal);">
  <h2 style="text-align: center;">
    Specjaliści oferujący usługę<br /><b>{{ title }}</b>
  </h2>
  {% include "partials/team.njk" %}
</article>

{% if service.desc02 %}
  <article class="panel">
    <div class="content">
      {{ service.desc02 | safe }}
    </div>
    {% if service.poster02 %}

{#
  FAQ accordion for one service. Used on the service page (heading "Najczęstsze pytania")
  and, with faqIndex set, once per service on /najczestsze-pytania/ (heading = service name).
#}
{% set slug = service.fullName | slugify %}
{% set faqs = faq | faqFor(slug) %}
{% if faqs.length %}
  <section
    class="faq"
    {% if faqIndex %}id="{{ slug }}"{% endif %}
    aria-labelledby="faq-{{ slug }}-title"
  >
    <h2 id="faq-{{ slug }}-title">
      {% if faqIndex %}{{ service.fullName }}{% else %}Najczęstsze pytania{% endif %}
    </h2>
    {% if faqIndex %}
      <p class="faq-service-link">
        <a href="/oferta/{{ slug }}/">Przejdź do opisu usługi</a>
      </p>
    {% endif %}
    <div class="faq-list">
      {% for item in faqs %}
        <details class="faq-item" name="faq-{{ slug }}">
          <summary>{{ item.question }}</summary>
          <div class="faq-answer">
            {% for p in item.paragraphs %}<p>{{ p }}</p>{% endfor %}
            {% if item.sources.length %}
              <p class="faq-sources">Źródła:
                {% for s in item.sources %}<a href="{{ s.url }}" rel="noopener" target="_blank">{{ s.domain }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
              </p>
            {% endif %}
          </div>
        </details>
      {% endfor %}
    </div>
    {% if not faqIndex %}
      <p class="faq-all-link">
        <a href="/najczestsze-pytania/">Zobacz pytania dotyczące wszystkich usług</a>
      </p>
    {% endif %}
  </section>
{% endif %}

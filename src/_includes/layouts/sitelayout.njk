<!DOCTYPE html>
<html lang="pl" data-aud-style="pill">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="initial-scale=1.0">
    <meta name="description" content="{{ description | metaDescription | escape }}">
    <link
      rel="shortcut icon"
      type="image/svg+xml"
      href="/media/psyche-favicon.svg"
    >
    {# the brand once: no " | Centrum PSYCHE Wrocław" when the title already names PSYCHE #}
    <title>{{ pageTitle }}{% if postfix and not ("psyche" in (pageTitle | lower)) %} | {{ postfix }}{% endif %}</title>
    <link rel="canonical" href="https://psyche.wroclaw.pl{{ page.url }}">
    {% if noindex %}
      <meta name="robots" content="noindex, follow">
    {% endif %}
    {# Google Site Verification #}
    <meta
      name="google-site-verification"
      content="DI1ldSgLOP1wL83v-NvrbF44G-SxWtnefJogD0QvC9k"
    >
    <meta
      name="google-site-verification"
      content="21qbgMgxZtLbWwl4AMb88lnijPJL8F0oxvXJqLex2YU"
    >
    <meta name="msvalidate.01" content="6A3F181E29D1D78CE723E40200A5F885">

    {# Fonts are self-hosted (src/fonts, @font-face in src/css/fonts.css); preload the two above the fold #}
    <link rel="preload" href="/fonts/fraunces-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/instrument-sans-normal-latin.woff2" as="font" type="font/woff2" crossorigin>

    {# All site CSS in one file, built from src/css by src/css-bundle.njk (order: CSS_FILES in eleventy.config.js) #}
    <link rel="stylesheet" href="/css/site.css">

    {# Main JS file #}
    <script src="/script/main.js" defer></script>
    {# Cookie banner: CookieConsent v3 (node_modules/vanilla-cookieconsent) + our settings #}
    <script src="/script/cookieconsent.umd.js" defer></script>
    <script src="/script/consent.js" defer></script>

    <script type="application/ld+json">{{ locations | clinicJsonLd(services, prices) | safe }}</script>
    {% if isHomepage %}
      <script type="application/ld+json">{% websiteJsonLd %}</script>
    {% else %}
      <script type="application/ld+json">{{ page.url | breadcrumbJsonLd(title) | safe }}</script>
    {% endif %}

    {% if service %}
      <script type="application/ld+json">{{ service | serviceJsonLd(prices) | safe }}</script>
    {% endif %}
    {% if member %}
      <script type="application/ld+json">{{ member | personJsonLd(services) | safe }}</script>
    {% endif %}
    {% if article %}
      <script type="application/ld+json">{{ article | articleJsonLd(page.url, team) | safe }}</script>
    {% endif %}

    {% if service %}
      {% set faqs = faq | faqFor(service.fullName | slugify) %}
      {% if faqs.length %}
        <script type="application/ld+json">{{ faqs | faqJsonLd(faqReview, service.fullName | slugify, team) | safe }}</script>
      {% endif %}
    {% endif %}
    {% if service or faqIndex %}
      <script src="/script/faq.js" defer></script>
    {% endif %}

    {# Google Consent Mode v2: everything is denied until the visitor agrees in the cookie
       banner (script/consent.js). A choice made on an earlier visit (cookie cc_cookie)
       applies straight away, so returning visitors are measured from the first tag. #}
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      (function () {
        var accepted = [];
        try {
          var match = document.cookie.match(/(?:^|;\s*)cc_cookie=([^;]*)/);
          if (match) accepted = JSON.parse(decodeURIComponent(match[1])).categories || [];
        } catch (e) {}
        var analytics = accepted.indexOf("analytics") > -1 ? "granted" : "denied";
        var marketing = accepted.indexOf("marketing") > -1 ? "granted" : "denied";
        gtag("consent", "default", {
          analytics_storage: analytics,
          ad_storage: marketing,
          ad_user_data: marketing,
          ad_personalization: marketing,
          functionality_storage: "granted",
          security_storage: "granted",
          wait_for_update: 500
        });
        gtag("set", "ads_data_redaction", marketing === "denied");
      })();
    </script>

    <!-- Google Tag Manager -->
    <script>
    (function(w, d, s, l, i) {
  w[l] = w[l] || [];
  w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
  var f = d.getElementsByTagName(s)[0],
    j = d.createElement(s),
    dl = l != "dataLayer" ? "&l=" + l : "";
  j.async = true;
  j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
  f.parentNode.insertBefore(j, f);
})(window, document, "script", "dataLayer", "GTM-KGCH6FT");
    </script>
    <!-- End Google Tag Manager -->

  </head>

  <body>
    {% include "partials/topbar.njk" %}
    {# Pagefind indexes <main> of every page except those with searchIndex: false (/szukaj/) #}
    {% set searchSection = page.url | searchSection %}
    <main
      {% if searchIndex !== false %}
        data-pagefind-body
        data-pagefind-meta="title:{{ title | escape }}"
        {% if searchSection %}data-pagefind-filter="Sekcja:{{ searchSection }}"{% endif %}
      {% endif %}
    >
      {# homepage video #}
      {% if isHomepage %}
        {% include "partials/homepage-video.njk" %}
      {% else %}
        {% include "partials/page-header.njk" %}
        {% include "partials/bcrumb.njk" %}
      {% endif %}

      {% block content %}
        {% include "partials/page-content.njk" %}
      {% endblock %}
    </main>
    {% include "partials/footer.njk" %}
  </body>
</html>

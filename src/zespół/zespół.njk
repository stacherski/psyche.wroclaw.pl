---
pagination:
  data: publishedTeam
  size: 1
  alias: member
permalink: "/zespół/{{ member.fullName | slugify }}/index.html"
layout: layouts/zespół.njk
eleventyComputed:
  title: "{{ member.fullName }}"
  pageTitle: "{{ member.fullName }}"
  description: "{{ member.description }} {{member.tagline}}"
postfix: Centrum PSYCHE Wrocław
isHomepage: false

---

<div class="member-single">
  <div>
    <h1>{{ member.fullName }}</h1>
  </div>

  <div>
    <div
      class="member"
      {% if member.filterKids %}
        kids
      {% endif %}
      {% if member.filterYouth %}
        youth
      {% endif %}
      {% if member.filterAdult %}
        adult
      {% endif %}
      {% if member.filterOnline %}
        online
      {% endif %}
    >
      <div class="bg"></div>
      <img
        src="/media/{{ member.photo }}"
        eleventy:widths="300, 600"
        alt="{{ member.fullName }}"
      >
      <div class="name">{{ member.fullName }}</div>
    </div>
    <div class="spec"><h5>{{ member.specialization | safe }}</h5></div>
  </div>
  <div>
    {{ member.bioPL | safe }}

    {% if member.onlineBooking == 'Yes' and member.booksyLink %}
      {# same booking button as the homepage hero (.btn__booksy) #}
      <div class="btn btn__booksy booksy-cta">
        <a href="{{ member.booksyLink }}" target="_blank" rel="noopener">Zarejestruj w Booksy</a>
      </div>
    {% endif %}
  </div>
</div>

{% set reviewsToDisplay = reviews | reviewsFor({ member: member.fullName }) %}
{% if reviewsToDisplay.length %}
  <article class="reviews-section">
    <h3>Opinie pacjentów</h3>
    {% set reviewsLimit = 6 %}
    {% include "partials/reviews.njk" %}
  </article>
{% endif %}

<article>
  <h3>Moje usługi w Centrum PSYCHE</h3>
  {% set teamMember = member.fullName %}
  {% include "partials/services.njk" %}
</article>

<article>
  <h3>Przyjmuję pacjentów w gabinecie:</h3>
  {% include "partials/locations.njk" %}
</article>
